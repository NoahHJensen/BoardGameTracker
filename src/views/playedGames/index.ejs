<!DOCTYPE html>
<html lang="dk">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<%- include('../partials/libs.ejs') %>
		<title>Spillet spil</title>
	</head>
	<style>
		.tr-content {
			cursor: pointer;
		}
	</style>
	<body>
		<%- include('../partials/header.ejs') %>
		<section class="section">
			<div class="container">
				<h1 class="title has-text-centered">Alle spillede spil</h1>
				<button class="button" onclick="newGame()">Tilføj nyt spil</button>
				<div class="table-container">
					<table class="table is-fullwidth is-hoverable">
						<thead>
							<tr>
								<th>#</th>
								<th>Brætspil</th>
								<th>Dato</th>
								<th>Tid siden</th>
								<th>Vinder</th>
							</tr>
						</thead>
						<tbody>
							<% playedGames.forEach((game, index) => { %>
							<tr class="tr-content" onclick="viewGame('<%= game.id %>')">
								<td><%= index + 1 %></td>
								<td><%= game.title %></td>
								<td><%= game.played_date %></td>
								<td><%= game.timeAgo %></td>
								<td><%= game.winner_name %></td>
							</tr>
							<% }); %>
						</tbody>
					</table>
				</div>
			</div>
		</section>
		<%- include('../partials/footer.ejs') %>
	</body>
	<script>
		function viewGame(id) {
			window.location.href = `/played-games/info/${id}`;
		}
		function newGame() {
			window.location.href = `/played-games/new`;
		}
	</script>
</html>
