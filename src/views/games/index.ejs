<!DOCTYPE html>
<html lang="dk">
	<head>
		<%- include('../partials/libs.ejs') %>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%= title %></title>
	</head>
	<style>
		.img-container {
			width: 123px;
		}
		.game-obj {
			overflow: hidden;
		}
	</style>
	<body>
		<%- include('../partials/header.ejs') %>
		<section class="hero is-primary">
			<div class="hero-body">
				<p class="title"><%= title %></p>
				<p class="subtitle">Her er listen af alle vores nuværende spil.</p>
			</div>
		</section>
		<section class="section">
			<div class="container">
				<button class="button" onclick="createGame()">Tilføj nyt spil</button>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<p class="title">Alle spil</p>
				<p class="subtitle">Total - <%= gamesTotal %> spil</p>
				<% games.forEach(game=> { %>
				<div class="box game-obj">
					<article class="media">
						<figure class="media-left img-container is-hidden-mobile">
							<p class="image is-4by5">
								<img class="has-ratio" src="<%= game.img_source %>" />
							</p>
						</figure>

						<div class="media-content">
							<div class="content">
								<p class="title is-3 has-text-primary"><%= game.title %></p>
								<p class="subtitle is-5"><%= game.description %></p>
							</div>
							<div class="level">
								<div class="level-left">
									<div class="tags">
										<div class="level-item">
											<span class="tag is-medium">
												Antal gange spillet: &nbsp;
												<strong class="has-text-info"
													><%= game.played_count %></strong
												>
											</span>
										</div>
										<div class="level-item">
											<span class="tag is-medium">
												Sidst spillet: &nbsp;
												<strong class="has-text-info"
													><%= game.lastPlayedAgo %></strong
												>
											</span>
										</div>
									</div>
								</div>
								<div class="level-right">
									<div class="level-item">
										<button
											class="button is-outlined is-info"
											onclick="viewGame('<%=game.id %>')">
											Statistik
										</button>
									</div>
								</div>
							</div>
						</div>
					</article>
				</div>
				<% }) %>
			</div>
		</section>
		<%- include('../partials/footer') %>
	</body>
	<script>
		function viewGame(id) {
			window.location.href = `/games/info/${id}`;
		}
		function createGame() {
			window.location.href = "/games/create";
		}
	</script>
</html>
