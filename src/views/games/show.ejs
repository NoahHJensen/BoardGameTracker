<!DOCTYPE html>
<html lang="dk">
	<head>
		<%- include('../partials/libs.ejs') %>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%= game.title %></title>
	</head>
	<style>
		.img-content {
			width: 246px;
			height: 300px;
		}
	</style>

	<body>
		<%- include('../partials/header') %>
		<section class="section">
			<div class="container">
				<div class="columns">
					<div class="column is-one-quarter">
						<figure class="image is-4by5">
							<img src="<%= game.imgSource %>" class="img-content" />
						</figure>
					</div>
					<div class="column">
						<div class="content">
							<p class="title">
								Viser spil statistik for <%= game.gameTitle %>
							</p>
							<p class="subtitle">Spil beskrivelse: <%= game.description %></p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<%- include('../partials/footer') %>
	</body>
</html>
