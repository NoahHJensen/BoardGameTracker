<!DOCTYPE html>
<html lang="dk">
	<head>
		<%- include('../partials/libs.ejs') %>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%= game.title %></title>
	</head>
	<style>
		.img-content {
			width: 246px;
			height: 300px;
		}
	</style>

	<body>
		<%- include('../partials/header') %>
		<section class="section">
			<div class="container">
				<div class="columns">
					<div class="column is-one-quarter">
						<figure class="image is-4by5">
							<img src="<%= game.img_source %>" class="img-content" />
						</figure>
					</div>
					<div class="column">
						<div class="content">
							<p class="title">Viser spil statistik for <%= game.title %></p>
							<p class="subtitle">Spil beskrivelse: <%= game.description %></p>
						</div>
					</div>
				</div>
			</div>
		</section>
		<!--Plays section-->
		<section class="section">
			<div class="container">
				<p class="title">Viser alle spillede spil for <%= game.title %></p>
				<table class="table">
					<thead>
						<tr>
							<th>ID</th>
							<th>Dato</th>
							<th>Vinder</th>
						</tr>
					</thead>
					<tfoot></tfoot>
					<tbody>
						<% plays.forEach(play => { %>
						<tr>
							<th><%= play.id %></th>
							<td><%= play.play_date %></td>
							<td><%= play.winnerName %></td>
						</tr>
						<% }) %>
					</tbody>
				</table>
			</div>
		</section>

		<%- include('../partials/footer') %>
	</body>
</html>
