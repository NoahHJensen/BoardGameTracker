<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<%- include('../partials/libs') %>
		<title>Alle spillere</title>
	</head>
	<body>
		<%- include('../partials/header') %>
		<section class="hero is-primary">
			<div class="hero-body">
				<p class="title">Spillere</p>
				<p class="subtitle">Her er listen af alle spillere!</p>
			</div>
		</section>
		<section class="section">
			<h1 class="subtitle">Tryk på spilleren for at få mere information!</h1>
			<div class="container">
				<div class="box">
					<p class="title">Noah Jensen</p>
					<div class="content"></div>
					<div class="field is-grouped is-grouped-multiline">
						<div class="control">
							<div class="tags has-addons">
								<span class="tag is-dark is-medium">Spil vundet</span>
								<span class="tag is-success is-medium">13</span>
							</div>
						</div>
						<div class="control">
							<div class="tags has-addons">
								<span class="tag is-dark is-medium">Spil spillede</span>
								<span class="tag is-info is-medium">15</span>
							</div>
						</div>

						<div class="control">
							<div class="tags has-addons">
								<span class="tag is-dark is-medium">Vundet procent</span>
								<span class="tag is-primary is-medium">86.66%</span>
							</div>
						</div>
						<button class="button">Se mere</button>
					</div>
				</div>
			</div>
		</section>
		<%- include('../partials/footer') %>
	</body>
</html>
