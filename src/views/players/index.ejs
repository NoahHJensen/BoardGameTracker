<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<%- include('../partials/libs') %>
		<title>Alle spillere</title>
	</head>
	<body>
		<%- include('../partials/header') %>
		<section class="hero is-primary">
			<div class="hero-body">
				<p class="title">Spillere</p>
				<p class="subtitle">Her er listen af alle spillere!</p>
			</div>
		</section>
		<section class="section">
			<h1 class="subtitle">Tryk på spilleren for at få mere information!</h1>
			<div class="container">
				<% players.forEach(player => { %>
				<div class="box">
					<p class="title"><%= player.name %></p>
					<div class="field is-grouped is-grouped-multiline">
						<div class="control">
							<div class="tags has-addons">
								<span class="tag is-dark is-medium">Spil vundet</span>
								<span class="tag is-primary is-medium"
									><%= player.gamesWon %></span
								>
							</div>
						</div>
						<div class="control">
							<div class="tags has-addons">
								<span class="tag is-dark is-medium">Spil spillede</span>
								<span class="tag is-info is-medium"
									><%= player.gamesPlayed %></span
								>
							</div>
						</div>
						<% if (player.gamesPlayed !== 0) { %>
						<div class="control">
							<div class="tags has-addons">
								<span class="tag is-dark is-medium">Vundet procent</span>
								<% let winPercentage = Math.round(((player.gamesWon /
								player.gamesPlayed) * 100)*100)/100%>
								<span
									class="tag <% if (winPercentage >= 50) { %> is-success <% } else { %> is-danger <% } %>is-medium">
									<%= winPercentage %>%</span
								>
							</div>
						</div>
						<% } %>

						<button class="button">Se mere</button>
					</div>
				</div>
				<% }) %>
			</div>
		</section>
		<%- include('../partials/footer') %>
	</body>
</html>
