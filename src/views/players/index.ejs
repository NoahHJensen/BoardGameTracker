<!DOCTYPE html>
<html lang="dk">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<%- include('../partials/libs') %>
		<title>Alle spillere</title>
	</head>
	<body>
		<%- include('../partials/header') %>
		<section class="hero is-primary">
			<div class="hero-body">
				<p class="title">Spillere</p>
				<p class="subtitle">Her er listen af alle spillere!</p>
			</div>
		</section>
		<section class="section">
			<div class="content has-text-centered">
				<p class="subtitle">Tryk på spilleren for at få mere information!</p>
				<button class="button" onclick="window.location.href = '/players/new'">
					Ny spiller
				</button>
			</div>

			<div class="container">
				<% players.forEach(player => { %>
				<div class="box">
					<p class="title"><%= player.name %></p>
					<div class="field is-grouped is-grouped-multiline">
						<div class="control">
							<div class="tags has-addons">
								<span class="tag is-dark is-large"
									>Total (<abbr title="Spillet / Vundet / Tabt">S/V/T</abbr
									>)</span
								>
								<strong class="tag is-info is-large"
									><%= player.games_played %></strong
								>
								<strong class="tag is-success is-large"
									><%= player.games_won %></strong
								>
								<strong class="tag is-danger is-large"
									><%= player.games_played - player.games_won %></strong
								>
							</div>
						</div>
						<% if (player.games_played !== 0) { %>
						<div class="control">
							<div class="tags has-addons">
								<span class="tag is-dark is-large">Vundet procent</span>
								<% let winPercentage = Math.round(((player.games_won /
								player.games_played) * 100)*100)/100%>
							</div>
						</div>
						<% } %>

						<button
							class="button"
							onclick="window.location.href = '/players/player/<%= player.id%>'">
							Se mere
						</button>
					</div>
				</div>
				<% }) %>
			</div>
		</section>
		<%- include('../partials/footer') %>
	</body>
</html>
